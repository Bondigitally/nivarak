# Pooled URL for the API (Neon: hostname includes -pooler). Run `neon env pull --file server/.env --services postgres` from repo root.
DATABASE_URL=postgres://user:pass@ep-xxx-pooler.region.aws.neon.tech/neondb?sslmode=require
# Direct URL for drizzle-kit push / migrate (no -pooler in hostname)
DATABASE_URL_UNPOOLED=postgres://user:pass@ep-xxx.region.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

COGNITO_USER_POOL_ID=ap-south-1_xxxxxxxxx
COGNITO_CLIENT_ID=your_cognito_app_client_id
AWS_REGION=ap-south-1

PORT=3000
NODE_ENV=development

# Razorpay — IAS-P detailed report unlock (use test keys in development)
RAZORPAY_KEY_ID=rzp_test_xxxxxxxx
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
IASP_REPORT_AMOUNT_PAISE=49900

# Browser origin(s) allowed to call the API (comma-separated)
CORS_ORIGINS=http://localhost:3000