{
  "name": "nivarak-api",
  "version": "1.0.0",
  "description": "Nivarak Elder Care Platform — Backend API (Phase 1 MVP)",
  "type": "module",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "start": "node dist/server.js",
    "build": "tsc",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "db:push:force": "drizzle-kit push --force",
    "neon:env": "neon env pull --config ../neon.ts --file .env --services postgres",
    "db:studio": "drizzle-kit studio",
    "db:migrate": "drizzle-kit migrate",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "healthcare",
    "elder-care",
    "nivarak",
    "api"
  ],
  "author": "Nivarak Team",
  "license": "PROPRIETARY",
  "dependencies": {
    "@hono/node-server": "^1.14.1",
    "@hugeicons/core-free-icons": "^4.3.5",
    "@hugeicons/react": "^1.1.10",
    "@react-pdf/renderer": "^4.9.0",
    "aws-jwt-verify": "^5.2.1",
    "dotenv": "^16.5.0",
    "drizzle-orm": "^0.44.2",
    "hono": "^4.7.10",
    "pino": "^9.6.0",
    "pino-pretty": "^13.0.0",
    "postgres": "^3.4.7",
    "razorpay": "^2.9.8",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "uuid": "^11.1.0",
    "zod": "^3.24.4"
  },
  "devDependencies": {
    "@types/node": "^22.15.21",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/uuid": "^10.0.0",
    "@vitest/coverage-v8": "^3.2.6",
    "drizzle-kit": "^0.31.11",
    "tsx": "^4.19.4",
    "typescript": "^5.8.3",
    "vitest": "^3.2.6"
  }
}
